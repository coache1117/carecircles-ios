{
  "appId": "com.carecircle.app1",
  "appName": "CareCircle",
  "webDir": "www",
  "server": {
    "url": "https://carecircle3.netlify.app",
    "allowNavigation": [
      "carecircle3.netlify.app",
      "*.supabase.co"
    ],
    "errorPath": "offline.html"
  },
  "ios": {
    "contentInset": "never",
    "scheme": "CareCircle"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchFadeOutDuration": 200,
      "showSpinner": false,
      "backgroundColor": "#FFFFFF"
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "LIGHT",
      "backgroundColor": "#FFFFFF"
    }
  }
}
